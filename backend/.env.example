# ==============================================================================
# Configuración de Producción en Internet - MyOutfit Social
# Copia este archivo a `.env` en tu servidor y rellena tus credenciales
# ==============================================================================

# Dominio público en Internet apuntando a la IP pública de tu servidor (Caddy genera HTTPS gratis)
DOMAIN_NAME=myoutfit.duckdns.org
DUCKDNS_TOKEN=TU_TOKEN_DUCKDNS
ACME_EMAIL=contacto@tudominio.com
TZ=Europe/Madrid

# Base de Datos PostgreSQL
POSTGRES_USER=myoutfit
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_GENERADO
POSTGRES_DB=myoutfit_social

# Seguridad JWT
JWT_ACCESS_SECRET=CAMBIAR_POR_HEX_64_CARACTERES_ACCESO
JWT_REFRESH_SECRET=CAMBIAR_POR_HEX_64_CARACTERES_REFRESH
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Google Sign-In (ID de cliente OAuth 2.0 tipo "Aplicación web" en Google Cloud Console)
GOOGLE_WEB_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# Correo SMTP para envío de códigos de recuperación de contraseña (ej: Gmail App Password, Brevo, Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM="MyOutfit <tucorreo@gmail.com>"

# Almacenamiento Multimedia
MAX_UPLOAD_SIZE_MB=15
WEBP_QUALITY=82
EPHEMERAL_TTL_HOURS=24
