<?xml version="1.0" encoding="utf-8"?>
<!-- RGPD Art. 25 y Art. 32: Impedir extracción automática de tokens JWT y claves API a nubes externas -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/social_session_preferences.preferences_pb" />
        <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/social_session_preferences.preferences_pb" />
        <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
